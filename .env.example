# --- Database ---
# Local (docker compose):
DATABASE_URL=postgres://labkit:labkit@localhost:5432/labkit
# Supabase: use the *pooler* connection string (port 6543) for serverless deployments.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the deployment. On Vercel this is inferred automatically.
BETTER_AUTH_URL=http://localhost:3000

# --- Attachment storage ---
# Local disk (self-hosted / Docker):
UPLOAD_DIR=./uploads
# Supabase Storage (required on serverless — local disk is ephemeral there).
# Create a bucket named "attachments" in the Supabase dashboard first.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=attachments
